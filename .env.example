# DigDeeper Local — environment template
# Copy to .env at the repository root. Never commit real credentials.

# ---------------------------------------------------------------------------
# Runtime / device
# ---------------------------------------------------------------------------
DEVICE=cuda
DEVICE_FP16=true
STORAGE_DIR=./storage
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Local LLM (OpenAI-compatible endpoint: Ollama, LM Studio, vLLM, llama.cpp...)
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local
LLM_FAST_MODEL=qwen2.5:7b-instruct
LLM_AUDIO_MODEL=qwen2-audio:7b

# ---------------------------------------------------------------------------
# Audio analysis / embeddings
# ---------------------------------------------------------------------------
# NOTE: `laion/larger_clap_music` looks tempting but its hub checkpoint ships
# an untrained audio tower (all audio embeddings collapse to ~0.99 similarity).
CLAP_MODEL_ID=laion/clap-htsat-unfused
CLAP_BATCH_SIZE=48
CLAP_MAX_VRAM_GB=4.0
ANALYSIS_MAX_WORKERS=10
PREVIEW_SECONDS=30
TARGET_SAMPLE_RATE=48000
PREVIEW_CONCURRENCY=24
PREVIEW_TIMEOUT_SECONDS=30
FFMPEG_TIMEOUT_SECONDS=60
INDEX_QUEUE_MAXSIZE=128

# ---------------------------------------------------------------------------
# Catalog / remote providers
# ---------------------------------------------------------------------------
ITUNES_RATE_LIMIT_PER_MINUTE=18
ITUNES_COUNTRY=US
ITUNES_TIMEOUT_SECONDS=30
DEEZER_RATE_LIMIT_PER_SEC=8
DEEZER_TIMEOUT_SECONDS=30
SEED_CRAWL_MAX_DEPTH=2
CATALOG_ELECTRONIC_RATIO=0.75
LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Storage paths (relative to the repository root)
# ---------------------------------------------------------------------------
SQLITE_PATH=./storage/app.db
LANCEDB_PATH=./storage/lancedb

# ---------------------------------------------------------------------------
# YouTube authentication (bypasses the "Sign in to confirm you're not a bot"
# gate for `dig analyze-set <youtube-url>`)
# ---------------------------------------------------------------------------
# Path to a Netscape-format cookies.txt exported from a logged-in browser.
# Relative paths are resolved against the repository root. Wins over the
# browser option below when both are set.
YTDLP_COOKIES_FILE=
# Alternative: let yt-dlp read cookies straight from a browser profile
# (firefox, edge, chrome, brave, chromium, ...).
YTDLP_COOKIES_FROM_BROWSER=
